  "event_types": [
    {"type":"chatEndedEvent","disposition":"terminal"},
    {"type":"sponsorOnlyModeEndedEvent","disposition":"system"},
    {"type":"sponsorOnlyModeStartedEvent","disposition":"system"},
    {"type":"newSponsorEvent","disposition":"membership"},
    {"type":"memberMilestoneChatEvent","disposition":"membership"},
    {"type":"superChatEvent","disposition":"monetization"},
    {"type":"superStickerEvent","disposition":"monetization"},
    {"type":"textMessageEvent","disposition":"message"},
    {"type":"tombstone","disposition":"deletion"},
    {"type":"userBannedEvent","disposition":"moderation"},
    {"type":"membershipGiftingEvent","disposition":"membership"},
    {"type":"giftMembershipReceivedEvent","disposition":"membership"},
