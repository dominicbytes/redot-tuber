  "data_lifecycle": [
    {"id":"oauth_access_token","secret":true,"storage":"memory_only","retention":"until_expiry_or_disconnect","clear_trigger":"disconnect_or_auth_loss"},
    {"id":"oauth_refresh_token","secret":true,"storage":"os_vault_only","retention":"until_revoke_or_disconnect","clear_trigger":"revoke_disconnect_or_clear_data"},
    {"id":"oauth_pkce_verifier","secret":true,"storage":"memory_only","retention":"authorization_attempt","clear_trigger":"success_denial_timeout_or_cancel"},
    {"id":"oauth_state","secret":true,"storage":"memory_only","retention":"authorization_attempt","clear_trigger":"success_denial_timeout_or_cancel"},
    {"id":"authorization_code","secret":true,"storage":"memory_only","retention":"token_exchange_only","clear_trigger":"exchange_success_or_failure"},
    {"id":"stream_ingestion_name","secret":true,"storage":"memory_only","retention":"while_stream_resource_is_referenced","clear_trigger":"clear_sensitive_disconnect_or_process_exit"},
    {"id":"session_descriptor","secret":false,"storage":"user_directory","retention":"until_disconnect_or_clear_data","clear_trigger":"disconnect_or_clear_data"},
    {"id":"channel_identity","secret":false,"storage":"user_directory_minimal","retention":"until_disconnect_or_clear_data","clear_trigger":"disconnect_or_clear_data"},
    {"id":"live_chat_messages","secret":false,"storage":"memory_only_default","retention":"current_process","clear_trigger":"stop_chat_disconnect_or_clear_data"},
    {"id":"remote_media","secret":false,"storage":"bounded_memory_or_opt_in_user_cache","retention":"configured_ttl_and_lru_bounds","clear_trigger":"clear_data_or_eviction"},
    {"id":"diagnostics","secret":false,"storage":"memory_ring_redacted","retention":"current_process","clear_trigger":"clear_data_or_process_exit"}
  ]
